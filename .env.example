# ──────────────────────────────────────────────────────────────
# SME Credit – Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Offline mode – set to true for demo without API keys
OFFLINE_MODE=true

# Statement ingestion
MAX_STATEMENT_BYTES=10000000
INGEST_DEBUG_KEEP_RAW=false

# Database
DATABASE_URL=sqlite:///./sme_credit.db

# Auth
JWT_SECRET=change-me-in-production

# CORS – frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Frontend env (prefix with NEXT_PUBLIC_ for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
